# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/zotrix?retryWrites=true&w=majority

# Long random secret (32+ chars)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_32_CHARS_MINIMUM

# One-time key used only when creating the first Master from the browser
SETUP_KEY=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET

# API server
PORT=5000

# Comma separated browser origins. Use * temporarily for first local test.
# Example after InfinityFree is live:
# CLIENT_URL=https://your-subdomain.infinityfreeapp.com
CLIENT_URL=http://localhost:5173

# Optional: environment label
NODE_ENV=development
